# ================================
# Wire DLC — Environment Template
# ================================

# Секретный ключ для подписи JWT-сессий (в проде обязательно замените на случайную строку >= 32 символов)
AUTH_SECRET="replace-with-a-strong-random-secret-at-least-32-chars"

# Пароль для первичного сидинга админ-аккаунта MrDarko (только при первом запуске пустой БД)
ADMIN_SEED_PASSWORD="MrDarkoAdmin!2026"

# Секретный инвайт-код для скрытой регистрации администратора (/register?invite=...)
# Оставьте пустым, чтобы отключить скрытую регистрацию по коду
ADMIN_INVITE_CODE="WIRE-ADMIN-2026"

# Режим БД (необязательно): при наличии NEXT_PUBLIC_SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY
# автоматически используется Supabase; локально — SQLite (data/wiredlc.db); на serverless без Supabase — in-memory (/tmp).
# Принудительно: "supabase" | "sqlite" | "memory"
DB_PROVIDER=""

# --- Supabase (для подключения реального облачного бэкенда) ---
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Discord OAuth2 (задел для входа через Discord) ---
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
DISCORD_REDIRECT_URI="http://localhost:3000/api/auth/discord/callback"

# --- Платёжные интеграции (заглушки / URL для перенаправления) ---
PAYMENT_SBP_REDIRECT_URL=""
PAYMENT_CRYPTO_WEBHOOK_SECRET=""
SUPPORT_DISCORD_URL="https://discord.gg/wiredlc-placeholder"
SUPPORT_TELEGRAM_URL="https://t.me/wiredlc_support_placeholder"
